# 复制为 .env 后按需修改；DSN 含 & 时请保留引号

FOLIO_ADDR=:8080
FOLIO_SECRET=change-me-to-a-long-random-string

# 数据库：sqlite（默认）| mysql | memory
FOLIO_DB_DRIVER=sqlite
FOLIO_DB=./data/folio.db

# MySQL（配合 docker compose up -d db）
# FOLIO_DB_DRIVER=mysql
# FOLIO_MYSQL_DSN='folio:folio_pass@tcp(127.0.0.1:3306)/folio?charset=utf8mb4&parseTime=True&loc=Local'

# Redis 可选，留空则自动降级（登出黑名单与浏览量去重失效）
# FOLIO_REDIS_ADDR=127.0.0.1:6379
# FOLIO_REDIS_PASSWORD=
# FOLIO_REDIS_DB=0

# 图片上传
FOLIO_UPLOAD_DIR=./data/uploads
FOLIO_UPLOAD_MAX_MB=10

# AI 摘要（可选；不填则编辑器不显示 AI 按钮）
# FOLIO_AI_API_KEY=sk-ant-...
# FOLIO_AI_MODEL=claude-opus-5-5
# FOLIO_AI_BASE_URL=

# 首次启动写入演示数据
FOLIO_DEMO=1

FOLIO_SITE_NAME=知微
FOLIO_SITE_DESC=一个人的知识花园，存放文章、手册与零散的思考。
FOLIO_SITE_OWNER=weijia
