# 复制为 .env 后按需修改；DSN 含 & 时请保留引号

FOLIO_ADDR=:8080
FOLIO_SECRET=change-me-to-a-long-random-string

# 数据库：sqlite（默认）| mysql | memory
FOLIO_DB_DRIVER=sqlite
FOLIO_DB=./data/folio.db

# MySQL（配合 docker compose up -d db）
# FOLIO_DB_DRIVER=mysql
# FOLIO_MYSQL_DSN='folio:folio_pass@tcp(127.0.0.1:3306)/folio?charset=utf8mb4&parseTime=True&loc=Local'

# Redis 可选，留空则自动降级（登出黑名单与浏览量去重失效）
# FOLIO_REDIS_ADDR=127.0.0.1:6379
# FOLIO_REDIS_PASSWORD=
# FOLIO_REDIS_DB=0

# 图片存储默认值；后台「存储设置」保存过配置后，以网页配置为准
FOLIO_STORAGE=local

# 图片上传（local 模式）
FOLIO_UPLOAD_DIR=./data/uploads
FOLIO_UPLOAD_MAX_MB=10

# 七牛云初始配置（可留空，之后在管理后台「存储设置」里填写）
# 后台保存后会以网页配置为准；七牛密钥会加密写入数据库
# FOLIO_QINIU_ACCESS_KEY=
# FOLIO_QINIU_SECRET_KEY=
# FOLIO_QINIU_BUCKET=
# FOLIO_QINIU_DOMAIN=https://image.example.com
# 区域可选 z0（华东）、cn-east-2（浙江）、z1（华北）、z2（华南）、na0（北美）、as0（新加坡）；留空会自动查询
# FOLIO_QINIU_REGION=z0
# FOLIO_QINIU_PREFIX=folio

# 邮件（可选；配置后才能使用邮箱验证码、邮箱登录与找回密码）
# 常用组合：QQ 邮箱 smtp.qq.com:587 + 授权码；Gmail smtp.gmail.com:587
# FOLIO_SMTP_HOST=smtp.qq.com
# FOLIO_SMTP_PORT=587
# FOLIO_SMTP_USER=you@qq.com
# FOLIO_SMTP_PASSWORD=你的授权码
# FOLIO_SMTP_FROM=you@qq.com
# FOLIO_SMTP_FROM_NAME=知微
# FOLIO_SMTP_TLS=0
# 本地没有 SMTP 时，设为 1 只把验证码写进日志，并在接口/页面直接显示
# FOLIO_MAIL_DEBUG=0

# 登录图形验证码（可选，默认关闭；开启后密码登录和发送邮箱验证码需要输入）
# FOLIO_LOGIN_CAPTCHA=0

# QQ 登录（可选；在 QQ 互联申请应用后填写）
# 回调地址必须与 QQ 互联后台填写的一致
# 配置并重启后，超级管理员可在「管理后台 → 注册与邀请」开启或关闭
# FOLIO_QQ_APP_ID=
# FOLIO_QQ_APP_KEY=
# FOLIO_QQ_REDIRECT=http://localhost:8080/api/auth/qq/callback
# 本地 Vite 开发时设为 http://localhost:5173，Docker/同源部署留空
# FOLIO_WEB_URL=

# AI 摘要（可选；不填则编辑器不显示 AI 按钮）
# 注意：这里的站点 Key 只用于 AI 摘要，/ask 问答始终要求用户自带 Key
# FOLIO_AI_API_KEY=sk-ant-...
# FOLIO_AI_MODEL=claude-opus-5-5
# FOLIO_AI_BASE_URL=

# AI 问答服务商地址覆盖（可选；留空使用官方地址，代理/专线部署时填写）
# FOLIO_DEEPSEEK_BASE_URL=
# FOLIO_GLM_BASE_URL=
# FOLIO_KIMI_BASE_URL=
# FOLIO_QWEN_BASE_URL=

# 首次启动写入演示数据
# 本地演示用 1；正式部署建议设为 0
FOLIO_DEMO=1

# 生产环境建议填写公开地址，RSS、sitemap 和分享卡片会使用绝对链接
# FOLIO_SITE_URL=https://your-domain.com

# 可选：docker-compose.edge.yml 的 Caddy 自动 HTTPS
# FOLIO_DOMAIN=folio.example.com
# ACME_EMAIL=you@example.com

FOLIO_SITE_NAME=知微
FOLIO_SITE_DESC=一个人的知识花园，存放文章、手册与零散的思考。
FOLIO_SITE_OWNER=weijia
# 图形验证码调试：设为 1 时在接口和页面直接显示答案，仅本地自测使用
# FOLIO_CAPTCHA_DEBUG=0
